[gd_scene format=3 uid="uid://qw7hh40eemfl"]

[sub_resource type="GDScript" id="GDScript_wyi4u"]
script/source = "extends CanvasLayer

func _ready():
	print(\"PAUSEMENU READY\")
	visible = false
	$VBoxContainer/ResumeButton.pressed.connect(resume)
	$VBoxContainer/MenuButton.pressed.connect(go_to_menu)
	$VBoxContainer/QuitButton.pressed.connect(get_tree().quit)

func _input(event):
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_ESCAPE:
		print(\"ESC DITEKAN\")
		if get_tree().paused:
			resume()
		else:
			pause()
		get_viewport().set_input_as_handled()

func pause():
	get_tree().paused = true
	visible = true
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

func resume():
	get_tree().paused = false
	visible = false
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func go_to_menu():
	get_tree().paused = false
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	get_tree().change_scene_to_file(\"res://MAIN MENU/SCENE/MainMenu.tscn\")
"

