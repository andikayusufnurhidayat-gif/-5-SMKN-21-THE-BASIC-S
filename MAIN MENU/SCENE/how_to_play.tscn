[node name="ItemText" type="RichTextLabel" parent="Center/Panel/VBox/Stack/PageItems/MarginItems"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.93, 0.91, 0.86, 1)
theme_override_font_sizes/normal_font_size = 20
theme_override_font_sizes/bold_font_size = 20
bbcode_enabled = true
text = "[b][color=#e8392f]ITEM[/color][/b]\n[b]Baking Soda[/b] (lempar): menutup jalan di lantai, Bu Jennifer tidak bisa lewat sekitar 12 detik.\n[b]Penghapus Papan Tulis[/b] (lempar): kalau kena, Bu Jennifer terbatuk dan berhenti sekitar 3 detik.\n[b]Peluit[/b]: Bu Jennifer tertarik ke arah bunyinya. Pancing dia menjauh!\n[b]Lem[/b]: taruh di lantai. Kalau diinjak, Bu Jennifer jalan pelan sekitar 5 detik.\n[b]Stabilo[/b]: menyorot buku yang tersembunyi selama sekitar 10 detik.\n[b]Es Teh[/b]: stamina bertambah dan kamu lebih cepat selama sekitar 8 detik.\n[b]Cokelat[/b]: stamina langsung penuh.\n[b]Koin[/b]: dipakai membeli barang di mesin kantin (1 koin = 1 barang), dan dibutuhkan untuk salah satu potongan kunci.\n[b]Kunci Loker[/b]: membuka loker terkunci (hadap loker, klik kanan).\n[b]Tas Ransel[/b]: langsung menambah 1 slot inventory.\n[b]Kunci Gerbang[/b]: hasil dari potongan kunci, untuk membuka gerbang sekolah.\n\n[b][color=#e8392f]TIPS[/color][/b]\n• Bu Jennifer mulai mengejar setelah buku pertama diambil. Kalau dia dekat, sembunyi (E) dan diam.\n• Lihat ke belakang (tahan Spasi) sebelum kamu memutuskan lari.\n• Jangan boros stamina. Kalau habis, kamu tidak bisa lari sampai pulih.\n• Jawab soal dengan teliti. Jawaban salah membuatnya makin cepat.\n• Berisik itu berbahaya: mengambil potongan kunci tertentu akan memancing Bu Jennifer ke tempatmu."
fit_content = true
scroll_active = false
autowrap_mode = 3

