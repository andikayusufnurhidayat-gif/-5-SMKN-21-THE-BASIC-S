[node name="GoalText" type="RichTextLabel" parent="Center/Panel/VBox/Stack/PageGoal/MarginGoal"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.93, 0.91, 0.86, 1)
theme_override_font_sizes/normal_font_size = 20
theme_override_font_sizes/bold_font_size = 20
bbcode_enabled = true
text = "[b][color=#e8392f]CERITA[/color][/b]\nSekolah udah bubar, tapi temanmu lagi kena masalah! Dia ninggalin semua buku catatannya di sekolah karena kecerobohannya, dan nggak sempat balik ambil karena harus buru-buru pulang. Masalah yang malah nyusahin kamu sendiri, emang beban tuh temenmu!\n\nJadi kamu harus balik ke sekolah malam-malam dan mencari semua buku catatannya. Nggak akan gampang! Guru di sekolah ini, Bu Jennifer, suka ngasih soal dadakan tiap kali ketemu kamu. Entah kenapa... mungkin dia punya masalah personal sama kamu.. :)\n\n[b][color=#e8392f]CARA MENANG[/color][/b]\n[b]1. Kumpulkan 7 buku catatan.[/b] Tiap buku ditemukan, kamu harus menjawab soal dalam 30 detik. Jawaban salah bikin Bu Jennifer makin cepat, dan hati-hati, ada buku yang soalnya jebakan.\n\n[b]2. Kumpulkan semua potongan kunci.[/b] Tiap potongan punya syarat sendiri: ditahan beberapa detik (berisik, Bu Jennifer akan datang!), butuh 1 koin, atau hanya bisa diambil saat Bu Jennifer sedang jauh. Kalau lengkap, Kunci Gerbang masuk ke inventory-mu.\n\n[b]3. Kabur lewat gerbang.[/b] Setelah semua buku terkumpul, Bu Jennifer ngamuk! Buka gerbang pakai Kunci Gerbang (klik kanan dari dekat), lalu lari keluar.\n\n[b][color=#e8392f]KALAH[/color][/b]\nKalau tertangkap Bu Jennifer, game over dan kamu kembali ke menu utama.\n\nSelamat bermain, dan semoga berhasil!"
fit_content = true
scroll_active = false
autowrap_mode = 3

