[node name="GoalText" type="RichTextLabel" parent="Margin/Panel/Layout/Pages/GoalPage/GoalPageMargin"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
text = "[b][color=#e8392f]STORY[/color][/b]\nSchool is over, but your friend is in trouble! They left all their notebooks at school out of carelessness, and had no time to go back for them because they had to rush home. A problem that ends up bothering you instead, what a burden of a friend!\n\nSo you have to go back to school at night and find every one of those notebooks. It will not be easy! The teacher here, Ms. Jennifer, loves giving pop quizzes whenever she sees you. Who knows why... maybe she has a personal problem with you.. :)\n\n[b][color=#e8392f]HOW TO WIN[/color][/b]\n[b]1. Collect 7 notebooks.[/b] Each time you pick one up, you must answer 3 questions on the board. Wrong answers make Ms. Jennifer angrier and faster, and be careful: some notebooks hold a trap question.\n\n[b]2. Collect all the key pieces.[/b] Each piece has its own condition: hold a button for a few seconds (it is noisy, Ms. Jennifer will come!), insert 1 coin, or take it only while Ms. Jennifer is far away. When the key is complete, the Gate Key goes into your inventory.\n\n[b]3. Escape through the gate.[/b] Once all notebooks are collected, Ms. Jennifer goes wild! Open the gate with the Gate Key (right-click from up close), then run out.\n\n[b][color=#e8392f]GAME OVER[/color][/b]\nIf Ms. Jennifer catches you, it is game over and you return to the main menu.\n\nHave fun, and good luck!"

