[node name="ItemsPage" type="ScrollContainer" parent="Margin/Panel/Layout/Pages"]
layout_mode = 2
unique_name_in_owner = true
size_flags_vertical = 3
horizontal_scroll_mode = 0
visible = false

[node name="ItemsPageMargin" type="MarginContainer" parent="Margin/Panel/Layout/Pages/ItemsPage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_right = 16

[node name="ItemsText" type="RichTextLabel" parent="Margin/Panel/Layout/Pages/ItemsPage/ItemsPageMargin"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
text = "[b][color=#e8392f]ITEMS[/color][/b]\n[b]Baking Soda[/b] (throw): blocks the floor, Ms. Jennifer cannot pass for about 12 seconds.\n[b]Chalkboard Eraser[/b] (throw): if it hits, Ms. Jennifer coughs and stops for about 3 seconds.\n[b]Whistle[/b]: Ms. Jennifer is drawn toward the sound. Lure her away!\n[b]Glue[/b]: place it on the floor. If she steps in it, Ms. Jennifer moves slowly for about 5 seconds.\n[b]Highlighter[/b]: makes hidden notebooks glow for about 10 seconds.\n[b]Iced Tea[/b]: restores stamina and makes you faster for about 8 seconds.\n[b]Chocolate[/b]: instantly refills your stamina.\n[b]Coin[/b]: buys an item from the vending machine (1 coin = 1 item), and is needed for one of the key pieces.\n[b]Locker Key[/b]: opens a locked locker (face the locker, right-click).\n[b]Backpack[/b]: instantly adds 1 inventory slot.\n[b]Gate Key[/b]: made from the key pieces, opens the school gate.\n\n[b][color=#e8392f]TIPS[/color][/b]\n• Ms. Jennifer starts chasing you after the first notebook. If she is close, hide ([E]) and stay still.\n• Look behind you (hold Space) before you decide to run.\n• Do not waste stamina. When it runs out, you cannot run until it recovers.\n• Answer carefully. Wrong answers make her faster.\n• Noise is dangerous: taking certain key pieces will draw Ms. Jennifer to you."

